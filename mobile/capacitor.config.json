{
  "appId": "online.argus.worker",
  "appName": "Аргус — грузчик",
  "webDir": "www",
  "android": {
    "backgroundColor": "#111315",
    "allowMixedContent": false,
    "minWebViewVersion": 92
  },
  "server": {
    "androidScheme": "https",
    "errorPath": "unsupported.html"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "auto",
      "style": "DARK"
    }
  }
}
