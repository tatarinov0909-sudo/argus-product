# Кэш браузера на стороне сайта.
#
# Хостинг по умолчанию отдаёт css и js с запасом в сорок пять дней. Пока
# адрес файла не меняется, браузер новую версию не запрашивает вовсе — и
# выложенная правка не доезжает до человека неделями. Ровно это и случилось
# 21.09.2026: владелец выдал ключ менеджера в старом кабинете и получил
# работника.
#
# Правило простое:
#   * страницы (html) — всегда спрашивать сервер, они маленькие;
#   * css и js — хранить долго, потому что в ссылке на них стоит отпечаток
#     содержимого (tools/stamp-assets.js): изменился файл — изменился адрес;
#   * шрифты — месяц: они меняются раз в год, но адрес у них без отпечатка.
#
# Обёртка IfModule обязательна: если на хостинге не включён mod_headers,
# директива Header роняет весь сайт в 500, а не «просто не работает».
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(woff2|woff|ttf|ico|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 month"
</IfModule>
